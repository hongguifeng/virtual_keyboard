<Window x:Class="VirtualKeyboard.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Keyboard 设置" Width="700" Height="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                <RowDefinition/><RowDefinition/><RowDefinition Height="220"/><RowDefinition/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="EnabledCheckBox" Grid.Row="0" Content="启用键盘" Margin="0,4"/>
            <CheckBox x:Name="AutoShowCheckBox" Grid.Row="1" Content="自动显示" Margin="0,4"/>
            <CheckBox x:Name="AutoHideCheckBox" Grid.Row="2" Content="自动隐藏" Margin="0,4"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal"><Label Content="宽度 (DIP)" Width="130"/><TextBox x:Name="WidthTextBox" Width="120"/></StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal"><Label Content="高度 (DIP)" Width="130"/><TextBox x:Name="HeightTextBox" Width="120"/></StackPanel>
            <StackPanel Grid.Row="5" Orientation="Horizontal"><Label Content="边距 (DIP)" Width="130"/><TextBox x:Name="MarginTextBox" Width="120"/></StackPanel>
            <Grid Grid.Row="6" Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="240"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <Label Content="透明程度"/>
                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.00" Maximum="0.70" TickFrequency="0.05"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
            <StackPanel Grid.Row="7" Orientation="Horizontal"><Label Content="布局 ID" Width="130"/><TextBox x:Name="LayoutIdTextBox" Width="240"/></StackPanel>
            <GroupBox Grid.Row="8" Header="自定义按键（最多 12 个）" Margin="0,8,0,4">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ListBox x:Name="CustomKeysList" DisplayMemberPath="Label" SelectionChanged="OnCustomKeySelectionChanged"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="AddCustomKeyButton" Content="添加" Width="76" Margin="0,0,6,0" Click="OnAddCustomKeyClick"/>
                            <Button x:Name="DeleteCustomKeyButton" Content="删除" Width="76" Click="OnDeleteCustomKeyClick"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="CustomKeyEditor" Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Label Content="按键名称"/>
                        <TextBox x:Name="CustomKeyLabelTextBox" Grid.Column="1" Margin="0,2"/>
                        <Label Grid.Row="1" Content="按下后"/>
                        <ComboBox x:Name="CustomActionModeComboBox" Grid.Row="1" Grid.Column="1" Margin="0,2"
                                  SelectionChanged="OnCustomActionModeChanged">
                            <ComboBoxItem Content="输入文字" Tag="text"/>
                            <ComboBoxItem Content="录制按键或组合键" Tag="shortcut"/>
                        </ComboBox>
                        <Grid x:Name="CustomTextEditor" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="文字内容"/>
                            <TextBox x:Name="CustomTextTextBox" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid x:Name="CustomShortcutEditor" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Content="已录制"/>
                            <Border Grid.Column="1" BorderBrush="#A0A0A0" BorderThickness="1" Padding="8,5" Background="#F5F5F5">
                                <TextBlock x:Name="RecordedShortcutText" Text="尚未录制"/>
                            </Border>
                            <Button x:Name="RecordShortcutButton" Grid.Row="1" Grid.Column="1" Content="开始录制"
                                    Width="110" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnRecordShortcutClick"/>
                        </Grid>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Foreground="DimGray" TextWrapping="Wrap"
                                   Text="录制时按下全部按键并全部松开，例如 Win+Tab 或 Ctrl+Shift+S。"/>
                    </Grid>
                </Grid>
            </GroupBox>
            <Grid Grid.Row="9">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Content="拖动位置保留"/>
                <ComboBox x:Name="PositionModeComboBox" Grid.Column="1" DisplayMemberPath="DisplayName"/>
                <CheckBox x:Name="DiagnosticsCheckBox" Grid.Column="2" Content="启用详细诊断" Margin="24,4,0,4"/>
                <TextBlock x:Name="PositionModeDescription" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                           Margin="0,4,0,0" Foreground="DimGray" TextWrapping="Wrap"
                           Text="{Binding ElementName=PositionModeComboBox, Path=SelectedItem.Description}"/>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="1" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="保存" Width="84" Margin="4" Click="OnSaveClick"/>
            <Button Content="取消" Width="84" Margin="4" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
