<Window x:Class="VirtualKeyboard.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Keyboard Settings" Width="720" SizeToContent="Height" MinWidth="680" MinHeight="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/VirtualKeyboard.App;component/Assets/app.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="#EEF2F7" Foreground="#1D2939">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2878F0"/>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#C9D2DF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#C9D2DF"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#25364D"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#25364D"/>
            <Setter Property="BorderBrush" Value="#B8C4D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EDF4FF"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#6EA5F5"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#D9E8FF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E67D6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#25364D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#D7DEE8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
    </Window.Resources>
    <Border x:Name="SettingsCard" Margin="14" Padding="4" Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="12">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal"><Label x:Name="LanguageLabel" Content="Language" Width="130"/><ComboBox x:Name="LanguageComboBox" Width="180" SelectionChanged="OnLanguageChanged"><ComboBoxItem Content="English" Tag="English"/><ComboBoxItem Content="简体中文" Tag="SimplifiedChinese"/></ComboBox></StackPanel>
            <CheckBox x:Name="EnabledCheckBox" Grid.Row="1" Content="Enable keyboard" Margin="0,4"/>
            <StackPanel Grid.Row="2">
                <CheckBox x:Name="AutoShowCheckBox" Content="Show automatically" Margin="0,4"/>
                <CheckBox x:Name="ShowLauncherButtonCheckBox" Content="Show a floating button before opening the keyboard"
                          Margin="20,4,0,4" IsEnabled="{Binding ElementName=AutoShowCheckBox, Path=IsChecked}"/>
            </StackPanel>
            <CheckBox x:Name="AutoHideCheckBox" Grid.Row="3" Content="Hide automatically" Margin="0,4"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,0"><Label x:Name="WidthLabel" Content="Width (DIP)" Width="130"/><TextBox x:Name="WidthTextBox" Width="120"/></StackPanel>
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,4,0,0"><Label x:Name="HeightLabel" Content="Height (DIP)" Width="130"/><TextBox x:Name="HeightTextBox" Width="120"/></StackPanel>
            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,4,0,0"><Label x:Name="MarginLabel" Content="Margin (DIP)" Width="130"/><TextBox x:Name="MarginTextBox" Width="120"/></StackPanel>
            <Grid Grid.Row="7" Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="240"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <Label x:Name="TransparencyLabel" Content="Transparency"/>
                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.00" Maximum="0.70" TickFrequency="0.05"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
            <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,4,0,0"><Label x:Name="LayoutIdLabel" Content="Layout ID" Width="130"/><TextBox x:Name="LayoutIdTextBox" Width="240"/></StackPanel>
            <GroupBox x:Name="CustomKeysGroup" Grid.Row="9" Header="Custom keys (up to 12)" Margin="0,10,0,6">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ListBox x:Name="CustomKeysList" MaxHeight="210" DisplayMemberPath="Label" SelectionChanged="OnCustomKeySelectionChanged"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="AddCustomKeyButton" Content="Add" Width="76" Margin="0,0,6,0" Click="OnAddCustomKeyClick"/>
                            <Button x:Name="DeleteCustomKeyButton" Content="Delete" Width="76" Click="OnDeleteCustomKeyClick"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="CustomKeyEditor" Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Label x:Name="KeyNameLabel" Content="Key label"/>
                        <TextBox x:Name="CustomKeyLabelTextBox" Grid.Column="1" Margin="0,2"/>
                        <Label x:Name="OnPressLabel" Grid.Row="1" Content="On press"/>
                        <ComboBox x:Name="CustomActionModeComboBox" Grid.Row="1" Grid.Column="1" Margin="0,2"
                                  SelectionChanged="OnCustomActionModeChanged">
                            <ComboBoxItem x:Name="TextModeItem" Content="Enter text" Tag="text"/>
                            <ComboBoxItem x:Name="ShortcutModeItem" Content="Record key or shortcut" Tag="shortcut"/>
                        </ComboBox>
                        <Grid x:Name="CustomTextEditor" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label x:Name="TextContentLabel" Content="Text"/>
                            <TextBox x:Name="CustomTextTextBox" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid x:Name="CustomShortcutEditor" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label x:Name="RecordedLabel" Content="Recorded"/>
                            <Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="9,6" Background="White">
                                <TextBlock x:Name="RecordedShortcutText" Text="Not recorded"/>
                            </Border>
                            <Button x:Name="RecordShortcutButton" Grid.Row="1" Grid.Column="1" Content="Start recording"
                                    Width="110" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnRecordShortcutClick"/>
                        </Grid>
                        <TextBlock x:Name="RecordingHelpText" Grid.Row="3" Grid.ColumnSpan="2" Foreground="#667085" TextWrapping="Wrap"
                                   Text="Press every key in the shortcut, then release them all."/>
                    </Grid>
                </Grid>
            </GroupBox>
            <Grid Grid.Row="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label x:Name="PositionRetentionLabel" Content="Keep dragged position"/>
                <ComboBox x:Name="PositionModeComboBox" Grid.Column="1" DisplayMemberPath="DisplayName"/>
                <CheckBox x:Name="DiagnosticsCheckBox" Grid.Column="2" Content="Enable detailed diagnostics" Margin="24,4,0,4"/>
                <TextBlock x:Name="PositionModeDescription" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                           Margin="0,4,0,0" Foreground="#667085" TextWrapping="Wrap"
                           Text="{Binding ElementName=PositionModeComboBox, Path=SelectedItem.Description}"/>
            </Grid>
            <StackPanel Grid.Row="11" Orientation="Horizontal" Margin="0,6,0,0">
                <CheckBox x:Name="AutoStartCheckBox" Content="Start with Windows" VerticalAlignment="Center"/>
                <TextBlock x:Name="AutoStartDescription" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#667085" TextWrapping="Wrap"
                           Text="Automatically start the virtual keyboard when you sign in to Windows"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="1" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}" Content="Save" Width="88" Margin="4" Click="OnSaveClick"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="84" Margin="4" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
