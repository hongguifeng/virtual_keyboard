<Window x:Class="VirtualKeyboard.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Keyboard 设置" Width="460" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="EnabledCheckBox" Grid.Row="0" Content="启用键盘" Margin="0,4"/>
            <CheckBox x:Name="AutoShowCheckBox" Grid.Row="1" Content="自动显示" Margin="0,4"/>
            <CheckBox x:Name="AutoHideCheckBox" Grid.Row="2" Content="自动隐藏" Margin="0,4"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal"><Label Content="宽度 (DIP)" Width="130"/><TextBox x:Name="WidthTextBox" Width="120"/></StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal"><Label Content="高度 (DIP)" Width="130"/><TextBox x:Name="HeightTextBox" Width="120"/></StackPanel>
            <StackPanel Grid.Row="5" Orientation="Horizontal"><Label Content="边距 (DIP)" Width="130"/><TextBox x:Name="MarginTextBox" Width="120"/></StackPanel>
            <StackPanel Grid.Row="6" Orientation="Horizontal"><Label Content="透明度 (0.30-1.00)" Width="130"/><TextBox x:Name="OpacityTextBox" Width="120"/></StackPanel>
            <StackPanel Grid.Row="7" Orientation="Horizontal"><Label Content="布局 ID" Width="130"/><TextBox x:Name="LayoutIdTextBox" Width="240"/></StackPanel>
            <StackPanel Grid.Row="8" Orientation="Horizontal"><Label Content="手动位置" Width="130"/><ComboBox x:Name="PositionModeComboBox" Width="180"/></StackPanel>
            <StackPanel Grid.Row="9" Orientation="Horizontal"><Label Content="自定义键标签" Width="130"/><TextBox x:Name="CustomKeyLabelTextBox" Width="240" MaxLength="32"/></StackPanel>
            <StackPanel Grid.Row="10" Orientation="Horizontal"><Label Content="自定义键输入内容" Width="130"/><TextBox x:Name="CustomKeyTextBox" Width="240" MaxLength="256"/></StackPanel>
            <CheckBox x:Name="DiagnosticsCheckBox" Grid.Row="11" Content="启用详细诊断" Margin="0,4"/>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="1" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="保存" Width="84" Margin="4" Click="OnSaveClick"/>
            <Button Content="取消" Width="84" Margin="4" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
