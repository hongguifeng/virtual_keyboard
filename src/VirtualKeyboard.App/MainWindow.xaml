<Window x:Class="VirtualKeyboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VirtualKeyboard.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="CanResize"
        MinWidth="620"
        MinHeight="280"
        Width="760"
        Height="340"
        Background="#F4F4F4">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#777777" BorderThickness="1" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="DragArea" Grid.Row="0" Background="#D9E7F7" Focusable="False"
                  MouseLeftButtonDown="OnDragAreaMouseLeftButtonDown"
                  MouseMove="OnDragAreaMouseMove"
                  MouseLeftButtonUp="OnDragAreaMouseLeftButtonUp">
                <TextBlock Text="Virtual Keyboard" VerticalAlignment="Center" Margin="6,0" Focusable="False" IsHitTestVisible="False" />
                <TextBlock x:Name="TitleStatusText" VerticalAlignment="Center" Margin="150,0,100,0" Foreground="Firebrick"
                           TextTrimming="CharacterEllipsis" Focusable="False" IsHitTestVisible="False" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SettingsButton" Content="设置" Width="52" Height="22" Margin="0,0,6,0" Focusable="False" IsTabStop="False" Click="OnSettingsClick" />
                    <Button x:Name="CloseButton" Content="×" Width="24" Height="22" Focusable="False" IsTabStop="False" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <local:KeyboardLayoutView x:Name="LayoutView" Grid.Column="0" KeyInvoked="OnLayoutKeyInvoked" />
                <local:CustomKeyColumnView x:Name="CustomKeysView" Grid.Column="1" Margin="4,0,0,0"
                                           KeyInvoked="OnLayoutKeyInvoked" />
            </Grid>
        </Grid>
    </Border>
</Window>
