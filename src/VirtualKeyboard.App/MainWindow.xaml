<Window x:Class="VirtualKeyboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VirtualKeyboard.App"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="760"
        Height="340"
        Background="#F4F4F4">
    <Border BorderBrush="#777777" BorderThickness="1" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="DragArea" Grid.Row="0" Background="#D9E7F7" Focusable="False"
                  MouseLeftButtonDown="OnDragAreaMouseLeftButtonDown"
                  MouseMove="OnDragAreaMouseMove"
                  MouseLeftButtonUp="OnDragAreaMouseLeftButtonUp">
                <TextBlock Text="Virtual Keyboard" VerticalAlignment="Center" Margin="6,0" Focusable="False" IsHitTestVisible="False" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SettingsButton" Content="设置" Width="52" Height="22" Margin="0,0,6,0" Focusable="False" IsTabStop="False" Click="OnSettingsClick" />
                    <Button x:Name="CloseButton" Content="×" Width="24" Height="22" Focusable="False" IsTabStop="False" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,8,0,0" Focusable="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CaptureTargetButton" Content="捕获当前目标" Margin="0,0,8,0" Focusable="False" IsTabStop="False" Click="OnCaptureTargetClick" />
                <TextBlock x:Name="SessionStatusText" Grid.Column="1" Text="尚未捕获目标" VerticalAlignment="Center" TextWrapping="Wrap" Focusable="False" />
            </Grid>
            <local:KeyboardLayoutView x:Name="LayoutView" Grid.Row="2" Margin="0,8,0,0" KeyInvoked="OnLayoutKeyInvoked" />
        </Grid>
    </Border>
</Window>
