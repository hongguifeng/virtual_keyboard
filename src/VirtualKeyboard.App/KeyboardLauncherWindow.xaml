<Window x:Class="VirtualKeyboard.App.KeyboardLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Width="40" Height="40">
    <Window.Resources>
      <Style x:Key="LauncherButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#2878F0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#75AEFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="11"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="#3989FF"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="#1C5DBD"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
      </Style>
    </Window.Resources>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
      <StackPanel x:Name="ButtonRow" Orientation="Horizontal">
       <Button x:Name="ExpandButton" Style="{StaticResource LauncherButtonStyle}" Click="OnExpandClick">
        <Viewbox Width="24" Height="18" IsHitTestVisible="False">
            <Grid Width="24" Height="18">
                <Rectangle RadiusX="3" RadiusY="3" Stroke="White" StrokeThickness="1.5"/>
                <Path Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 5,5 L 6,5 M 9,5 L 10,5 M 13,5 L 14,5 M 17,5 L 19,5
                            M 5,9 L 6,9 M 9,9 L 10,9 M 13,9 L 14,9 M 17,9 L 19,9 M 7,13 L 17,13"/>
            </Grid>
        </Viewbox>
       </Button>
      </StackPanel>
    </Viewbox>
</Window>
